# PMPilot Backend Configuration

# Database: SQLite default; or PostgreSQL: postgresql://user:password@localhost:5432/pmpilot
DATABASE_URL=sqlite:///./pmpilot.db

# Authentication
JWT_SECRET=super-secret-pmpilot-jwt-key-change-in-production-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# LLM Provider Configuration: 'mock', 'gemini', 'ollama', or 'openai_compat'
LLM_PROVIDER=mock

# Native Google Gemini Configuration (Required if LLM_PROVIDER=gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Local Ollama Configuration (Required if LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# OpenAI-Compatible / Groq / OpenRouter Configuration (Required if LLM_PROVIDER=openai_compat)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Server Host & Port
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
